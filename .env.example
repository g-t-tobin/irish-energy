# Irish Energy Analytics Platform - Environment Variables

# AWS Configuration
AWS_REGION=eu-west-1
AWS_PROFILE=irish-energy-data-platform-dev

# S3 Bucket Names (Gold Layer)
BRONZE_BUCKET=irish-energy-bronze-851725545966-eu-west-1
SILVER_BUCKET=irish-energy-silver-851725545966-eu-west-1
GOLD_BUCKET=irish-energy-gold-851725545966-eu-west-1

# S3 Monitoring Storage Configuration
S3_BUCKET_NAME=irish-energy-monitoring-851725545966-eu-west-1
S3_MONITORING_PREFIX=monitoring/

# Storage Backend Selection
# Options: 'local', 's3'
STORAGE_BACKEND=local

# Data Sources
EIRGRID_API_URL=https://api.eirgrid.com
OPEN_METEO_API_URL=https://archive-api.open-meteo.com

# Ingestion Settings
RETRY_ATTEMPTS=3
REQUEST_TIMEOUT=30

# Data Processing
PARQUET_COMPRESSION=snappy