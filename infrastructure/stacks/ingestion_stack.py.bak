from aws_cdk import (
    Stack,
    aws_lambda as _lambda,
    aws_events as events,
    aws_events_targets as targets,
    aws_iam as iam,
    Duration,
)
from constructs import Construct

class IngestionStack(Stack):
    """Creates infrastructure for data ingestion"""

    def __init__(self, scope: Construct, construct_id: str, **kwargs) -> None:
        super().__init__(scope, construct_id, **kwargs)

        # Create IAM role for ingestion lambda
        ingestion_role = iam.Role(
            self, "IngestionRole",
            assumed_by=iam.ServicePrincipal("lambda.amazonaws.com"),
            managed_policies=[
                iam.ManagedPolicy.from_aws_managed_policy_name("service-role/AWSLambdaBasicExecutionRole"),
            ]
        )

        # Add S3 permissions
        ingestion_role.add_to_policy(
            iam.PolicyStatement(
                actions=["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
                resources=[
                    f"arn:aws:s3:::irish-energy-bronze-{self.account}-{self.region}/*",
                    f"arn:aws:s3:::irish-energy-silver-{self.account}-{self.region}/*"
                ]
            )
        )

        # Create ingestion lambda function for EirGrid
        eirgrid_ingestion_fn = _lambda.Function(
            self, "EirGridIngestionFunction",
            runtime=_lambda.Runtime.PYTHON_3_9,
            handler="src.ingestion.eirgrid_ingestion.lambda_handler",
            code=_lambda.Code.from_asset("src/ingestion"),
            timeout=Duration.minutes(5),
            role=ingestion_role,
            environment={
                "BRONZE_BUCKET": f"irish-energy-bronze-{self.account}-{self.region}",
                "SILVER_BUCKET": f"irish-energy-silver-{self.account}-{self.region}"
            }
        )

        # Create ingestion lambda function for Open-Meteo
        openmeteo_ingestion_fn = _lambda.Function(
            self, "OpenMeteoIngestionFunction",
            runtime=_lambda.Runtime.PYTHON_3_9,
            handler="src.ingestion.openmeteo_ingestion.lambda_handler",
            code=_lambda.Code.from_asset("src/ingestion"),
            timeout=Duration.minutes(5),
            role=ingestion_role,
            environment={
                "BRONZE_BUCKET": f"irish-energy-bronze-{self.account}-{self.region}",
                "SILVER_BUCKET": f"irish-energy-silver-{self.account}-{self.region}"
            }
        )

        # Create EventBridge rule for scheduled ingestion (daily)
        ingestion_rule = events.Rule(
            self, "DailyIngestionSchedule",
            schedule=events.Schedule.rate(Duration.days(1))
        )

        # Add targets to the rule
        ingestion_rule.add_target(targets.LambdaFunction(eirgrid_ingestion_fn))
        ingestion_rule.add_target(targets.LambdaFunction(openmeteo_ingestion_fn))